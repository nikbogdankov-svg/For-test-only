{
  "name": "mini-blog",
  "version": "1.0.0",
  "description": "A small blog with posts, comments and likes — React frontend, Express backend, SQLite or online Postgres",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=.env.local server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6"
  }
}
