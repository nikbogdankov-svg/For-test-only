{
  "name": "mini-blog",
  "version": "1.0.0",
  "description": "A small blog with posts, comments and likes — Express backend + SQLite or online Postgres",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server.js",
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.1"
  }
}
